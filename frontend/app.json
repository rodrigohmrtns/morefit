{
  "expo": {
    "name": "VitaTracker",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.fitproecosystem.fec156",
      "infoPlist": {
        "NSCameraUsageDescription": "Escanear refeições com IA",
        "NSPhotoLibraryUsageDescription": "Selecionar fotos de refeições"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F2F4F2"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.fitproecosystem.fec156",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2F4F2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecionar fotos de refeições",
          "cameraPermission": "Escanear refeições com IA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
